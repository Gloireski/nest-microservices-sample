{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
    "^@app/constants(|/.*)$": "<rootDir>/libs/constants/src/$1",
    "^@app/(.*)$": "<rootDir>/libs/$1",
    "^apps/(.*)$": "<rootDir>/apps/$1"
  }
}
